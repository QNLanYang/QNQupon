# 服务默认仅监听本机回环；对外提供服务请置于反向代理之后（见 docs/DEPLOYMENT.md）。
HOST=127.0.0.1
PORT=3100
PUBLIC_BASE_URL=https://coupon.example.com
# 管理后台允许的 Host（逗号分隔、大小写不敏感）。localhost、127.0.0.1、[::1] 恒放行，无需配置；
# 从其他地址访问后台（内网域名或 IP）才需要写进来，否则后台返 404。
ADMIN_HOSTS=
# 反向代理信任：设 127.0.0.1 = 只信任本机反向代理传来的真实 IP；
# 留空 = 不信任任何代理（直连模式）。不要设 true（全信任，客户端可伪造 XFF）。
TRUST_PROXY=127.0.0.1
DATABASE_PATH=./data/qnqupon.db
APP_ENCRYPTION_KEY=
SESSION_SECRET=
COOKIE_SECURE=true

# ---- 防护参数（修改后需重启服务）----
# 限流格式：次数/窗口，窗口单位 s/m/h/d，如 10/10m = 10 分钟内最多 10 次。
# 写法非法时该条目回退默认值；各入口对应关系见 SECURITY.md「限流」。
RATE_LIMIT_REDEEM_PAGE=90/1m
RATE_LIMIT_REDEEM=12/1m
RATE_LIMIT_VERIFY=30/1m
RATE_LIMIT_SETUP=5/10m
RATE_LIMIT_LOGIN=10/10m
RATE_LIMIT_PROFILE=5/10m
RATE_LIMIT_ADMIN_WRITE=30/10m
RATE_LIMIT_ADMIN_MANAGE=10/10m
RATE_LIMIT_ADMIN_SENSITIVE=5/10m
# 后台会话有效期（小时）
SESSION_HOURS=12
# 密码最少位数
PASSWORD_MIN_LENGTH=12

# 登录页 Cloudflare Turnstile 人机验证（可选防护，改后重启生效）。
# 两把密钥在 Cloudflare 控制台「Turnstile」创建；必须同时填写，只填一个启动报错；皆空 = 关闭（默认）。
# 启用前提：访问后台的浏览器能加载组件、本服务器能访问其 siteverify 接口，否则登录请求会被拒绝。
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# 业务保留参数（回收天数、确认码可查时长等）在后台「服务设置」中修改，无需重启。

# SMTP 密码可安全地加密存入数据库；此密钥本身不得提交至 Git。
# APP_ENCRYPTION_KEY 与 SESSION_SECRET 是机密，必须足够随机、足够长（建议 32 位以上）；
# 生成方式不限：运行仓库自带的 scripts/generate-secrets.js（node scripts/generate-secrets.js）
# 可一次生成两串，也可自行敲入一长串字符，或使用任意在线随机字符串生成器均可。
